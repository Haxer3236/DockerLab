#Creating our own network


#Create the own network name internal-net
    docker network create internal-net
# create a internal docker network using --internal flag
    docker network create --internal vault-net
#List the all network 
    docker network ls
#Creating the container with name db-service with own network
    docker run -d --name db-service --network internal-net alpine sh -c "tail -f /dev/null"
#Creating the second container with name web-app with own network
    docker run -d --name web-app --network internal-net alpine sh -c "ping db-service"
# enter the both container and pinging each one by one
    docker exec -it web-app sh
    docker exec -it db-service sh
#Connect the network with runing conatainer 
#(network name - private-net, container name backen-api)
    docker network connect private-net backend-api 
#It disable the comunication from the container to tcp request
    sudo iptables -I DOCKER-USER -s 203.0.113.0/24 -p tcp -j DROP
