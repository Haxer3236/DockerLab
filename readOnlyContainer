Complete Solution Script
#!/bin/bash


# 1. The Solution: Hardened Redis
echo "Deploying Immutable Redis..."

# Create volume for persistence (Requirement 2)
docker volume create secure-data

# Deploy with Security Policy:
# - --read-only: Satisfies Immutability requirement
# - -v secure-data:/data: Fixes the crash by making /data writable (via volume)
# - --user 999: Satisfies Identity requirement
# - --cap-drop ALL: Satisfies Least Privilege requirement
docker run -d \
  --name hardened-redis \
  --read-only \
  --user 999 \
  --cap-drop ALL \
  -v secure-data:/data \
  redis:alpine

# 2. Verify Status
echo "Verifying deployment..."
sleep 2
if [ "$(docker inspect -f '{{.State.Running}}' hardened-redis)" == "true" ]; then
    echo "Container is RUNNING."
    # Functional Check: Set a key
    docker exec hardened-redis redis-cli set security enabled >/dev/null
    echo "Redis Response: $(docker exec hardened-redis redis-cli get security)"
else
    echo "Container FAILED. Logs:"
    docker logs hardened-redis
fi
