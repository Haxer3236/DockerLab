FROM python:3.9-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY . .
CMD ["python", "app.py"]


# Command to docker file to build the image 
docker build -t tag_name:version .
docker build -t weather-api:v1 .

Here
 -t -> stand for the tahg name
 . stand for the currnet directory
